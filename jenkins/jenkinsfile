pipeline {
    agent any

    stages {
        stage('Unit Tests - Backend') {
            agent {
                docker {
                    image 'golang:1.25'
                    reuseNode true
                }
            }

            environment {
                GOCACHE = '/tmp/go-build'
            }

            steps {
                dir('bugtracker-backend') {
                    sh 'go test -v ./...'
                    echo 'hello from backend tests'
                }
            }
        }
        stage('Unit tests - Frontend') {
            agent {
                docker {
                    image 'node:20'
                    reuseNode true
                }
            }
            environment {
                       TZ = 'Asia/Kolkata'
            }

            steps {
                dir('bugtracker-frontend') {
                    sh 'npm ci'
                    sh 'npm test'
                    echo 'hello from frontend tests'
                }
            }
        }
    }
}